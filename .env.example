# ==============================================================================
# AI College Admission Enquiry Assistant - Environment Configuration Template
# ------------------------------------------------------------------------------
# To use: Copy this file to '.env' and adjust the variables as required.
# In development/presentation mode, all local/free defaults work out of the box!
# When upgrading to paid plans later, simply update these values without code rewrites.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port on which the Express HTTP server will listen
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Similarity & Semantic Matching Configuration
# ------------------------------------------------------------------------------
# Minimum cosine similarity score (0.0 to 1.0) required to consider an FAQ match.
# Scores below this threshold trigger staff handoff.
# Recommended optimal value based on benchmark evaluation: 0.86
SIMILARITY_THRESHOLD=0.86

# High confidence threshold (0.0 to 1.0). Matches at or above this score are answered
# directly from the FAQ/spoken answer without needing an LLM call.
# Matches between SIMILARITY_THRESHOLD and HIGH_CONFIDENCE_THRESHOLD require LLM verification.
HIGH_CONFIDENCE_THRESHOLD=0.90

# ------------------------------------------------------------------------------
# 3. Embedding Provider Configuration (Free Local vs Paid Cloud Upgrade)
# ------------------------------------------------------------------------------
# Provider choice: 'local' (Free offline HuggingFace model), 'openai', or 'gemini'
EMBEDDING_PROVIDER=local

# Model name for embeddings
# Default for 'local': 'Xenova/multilingual-e5-small'
# Default for 'openai': 'text-embedding-3-small'
# Default for 'gemini': 'text-embedding-004'
EMBEDDING_MODEL=Xenova/multilingual-e5-small

# OpenAI API Key (leave empty for free local mode; add key to upgrade to paid OpenAI)
OPENAI_API_KEY=

# Google Gemini API Key (leave empty for free local mode; add key to upgrade to Gemini)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3b. LLM Spoken Answer Layer (Gemini, OpenAI, Claude)
# ------------------------------------------------------------------------------
# Enable or disable LLM answer synthesis ('true' or 'false')
# When false, answers return verbatim from FAQ entries
LLM_ENABLED=true

# LLM Provider choice: 'gemini', 'openai', or 'claude'
LLM_PROVIDER=gemini

# LLM model name
# Recommended for Google Gemini: 'gemini-3.5-flash-lite'
# Recommended for OpenAI: 'gpt-4o-mini'
# Recommended for Claude: 'claude-3-5-haiku-20241022'
LLM_MODEL=gemini-3.5-flash-lite

# LLM API Timeout in milliseconds (default: 4000ms = 4 seconds for web queries)
LLM_TIMEOUT_MS=4000

# LLM Phone Call Timeout in milliseconds (default: 2500ms = 2.5 seconds)
# Keeps telephone latency snappy: if LLM takes longer than 2.5s, falls back to direct FAQ answer
LLM_PHONE_TIMEOUT_MS=2500

# ------------------------------------------------------------------------------
# 4. Database Configuration (SQLite Default vs PostgreSQL)
# ------------------------------------------------------------------------------
# Database URL:
# - Leave empty (default) to use local SQLite database stored at ./data/admissions.db
# - Or set to PostgreSQL URL: postgresql://username:password@localhost:5432/admissions
DATABASE_URL=

# Explicit database type ('sqlite' or 'postgres')
DATABASE_TYPE=sqlite

# Path to initial FAQ seed file
FAQ_DATA_PATH=./faq.json

# ------------------------------------------------------------------------------
# 5. Telephony & Phone Call Service Configuration (Twilio Voice AI)
# ------------------------------------------------------------------------------
# Telephony provider: 'twilio' or 'mock' (local simulator)
TELEPHONY_PROVIDER=twilio

# Call Mode:
# - 'conversationrelay': Twilio ConversationRelay real-time WebSocket mode (low latency, interruption handling)
# - 'gather': Classic TwiML fallback using Twilio <Gather> speech recognition and <Say> in a loop
CALL_MODE=conversationrelay

# Twilio Account SID (found in Twilio Console Dashboard)
TWILIO_ACCOUNT_SID=

# Twilio Auth Token (used for API access and webhook signature verification)
TWILIO_AUTH_TOKEN=

# Twilio Inbound Phone Number assigned to the admission hotline
TWILIO_PHONE_NUMBER=

# Public base URL of your server (e.g. https://your-domain.ngrok-free.app or production domain)
# Used by Twilio to connect Webhooks and WebSockets (wss://)
PUBLIC_BASE_URL=http://localhost:3000

# Text-to-Speech (TTS) Voice Configuration for Phone Calls
# Preferred provider: 'elevenlabs' (falls back automatically to Google if key missing)
TTS_PROVIDER=elevenlabs

# ElevenLabs API Key (optional: for local audio generator and direct ElevenLabs API testing)
ELEVENLABS_API_KEY=

# ElevenLabs Voice IDs:
# - English Voice ID: e.g. '21m00Tcm4TlvDq8ikWAM' (Rachel) or custom cloned voice
# - Hindi Voice ID: e.g. 'AZnzlk1XvdvUeBnXmlld' (Domi) or custom Hindi voice
ELEVENLABS_VOICE_EN=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_HI=AZnzlk1XvdvUeBnXmlld
ELEVENLABS_MODEL=eleven_flash_v2_5

# Google Fallback voices (used if ElevenLabs is not configured or as 1-line switch)
GOOGLE_VOICE_EN=Google.en-IN-Neural2-A
GOOGLE_VOICE_HI=Google.hi-IN-Neural2-A

# Active TTS Voice variables passed to Twilio
TTS_VOICE_EN=21m00Tcm4TlvDq8ikWAM
TTS_VOICE_HI=AZnzlk1XvdvUeBnXmlld

# ------------------------------------------------------------------------------
# 6. Admission Staff Contact Information (Used for Handoff & UI)
# ------------------------------------------------------------------------------
# Admission office phone number shown when handoff is triggered
HANDOFF_PHONE=+91-551-2273901 / 2273902

# Admission support email address
HANDOFF_EMAIL=admission@mmmut.ac.in

# Working hours for admission helpdesk
HANDOFF_HOURS=Mon - Sat (10:00 AM - 5:00 PM)

# ------------------------------------------------------------------------------
# 7. Admin & Security Configuration for /admin Panel
# ------------------------------------------------------------------------------
# Username for admin panel login
ADMIN_USERNAME=admin

# Strong password for admin panel login at /admin
ADMIN_PASSWORD=AdminSecure2026!Pass

# Secret API key for programmatic administrative API access
ADMIN_API_KEY=admin_dev_secret_key_2026

# Secret key used for signing session tokens
ADMIN_SESSION_SECRET=admin_jwt_session_secret_key_random_2026

# ------------------------------------------------------------------------------
# 8. Rate Limiting Configuration
# ------------------------------------------------------------------------------
# Time window in milliseconds for rate limiting (default: 60000ms = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum number of allowed requests per IP within the time window
# Set to 200 so automated test suites (like test-threshold) run without being blocked
RATE_LIMIT_MAX_REQUESTS=200

# ------------------------------------------------------------------------------
# 9. Telephony Staff Dialer & Busy-Line Logic
# ------------------------------------------------------------------------------
# Dialer provider: 'mock' (for local simulation/testing) or 'twilio' (production Twilio Dial)
DIALER_PROVIDER=mock

# Timeout in seconds to ring each staff member before trying next in sequence (default: 20s)
STAFF_DIAL_TIMEOUT_SECONDS=20

# Maximum number of staff numbers to try sequentially per handoff call (default: 3)
MAX_STAFF_ATTEMPTS_PER_CALL=3

# Maximum transfers a single caller can trigger in a short window to prevent spam (default: 3)
MAX_TRANSFERS_PER_CALLER=3

# Rate limit window for caller transfers in milliseconds (default: 900000ms = 15 minutes)
TRANSFER_RATE_LIMIT_WINDOW_MS=900000

# ------------------------------------------------------------------------------
# 10. Working Hours & Holiday Calendar
# ------------------------------------------------------------------------------
# Office hours start and end in HH:MM 24-hour format
OFFICE_HOURS_START=09:00
OFFICE_HOURS_END=17:00

# Working days of the week: comma-separated integers (1=Monday, 6=Saturday, 0=Sunday)
OFFICE_DAYS=1,2,3,4,5,6

# Timezone for office hours evaluation
OFFICE_TIMEZONE=Asia/Kolkata

# Official university admission holidays (YYYY-MM-DD, comma-separated)
OFFICE_HOLIDAYS=2026-01-26,2026-08-15,2026-10-02

# ------------------------------------------------------------------------------
# 11. Callback Requests & Caller Privacy Retention
# ------------------------------------------------------------------------------
# Number of days to retain callback requests before automatic purge (default: 30 days)
CALLBACK_RETENTION_DAYS=30

# Dedicated 32-byte (64 hex characters) AES-256-GCM encryption key for caller phone numbers
# Must be set in .env. Never commit this key to version control.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CALLBACK_ENCRYPTION_KEY=your_64_character_hex_key_here

